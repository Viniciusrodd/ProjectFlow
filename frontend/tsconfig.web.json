{
   "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
   "include": [
      "src/renderer/src/env.d.ts",
      "src/renderer/src/**/*",
      "src/renderer/src/**/*.tsx",
      "src/preload/*.d.ts"
   ],
   "compilerOptions": {
      "composite": true,
      "jsx": "react-jsx",
      "ignoreDeprecations": "6.0",
      "baseUrl": ".",
      "paths": {
         // modules
         "@auth/*": ["src/renderer/src/modules/auth/*"]
      }
   }
}
