{
   "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
   "include": [
      "src/renderer/src/env.d.ts",
      "src/renderer/src/**/*",
      "src/renderer/src/**/*.tsx",
      "src/shared/**/*"
   ],
   "compilerOptions": {
      "composite": true,
      "jsx": "react-jsx",
      "ignoreDeprecations": "6.0",
      "baseUrl": ".",
      "paths": {
         // modules
         "@renderer/*": ["src/renderer/*"],
         "@shared/*": ["src/shared/*"],
      }
   }
}
