{
   "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
   "include": [
      "src/renderer/src/env.d.ts",
      "src/renderer/src/**/*",
      "src/renderer/src/**/*.tsx",
      "src/preload/*.d.ts"
   ],
   "compilerOptions": {
      "composite": true,
      "jsx": "react-jsx",
      "ignoreDeprecations": "6.0",
      "baseUrl": ".",
      "paths": {
         // modules
         "@activityLog/*": ["src/renderer/src/modules/activityLog/*"],
         "@attachment/*": ["src/renderer/src/modules/attachment/*"],
         "@auth/*": ["src/renderer/src/modules/auth/*"],
         "@board/*": ["src/renderer/src/modules/board/*"],
         "@comment/*": ["src/renderer/src/modules/comment/*"],
         "@labels/*": ["src/renderer/src/modules/labels/*"],
         "@notification/*": ["src/renderer/src/modules/notification/*"],
         "@organization/*": ["src/renderer/src/modules/organization/*"],
         "@project/*": ["src/renderer/src/modules/project/*"],
         "@task/*": ["src/renderer/src/modules/task/*"],
         "@user/*": ["src/renderer/src/modules/user/*"],
      }
   }
}
